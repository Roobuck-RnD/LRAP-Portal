config rpcd
	option socket /var/run/ubus/ubus.sock
	option timeout 30

config login
	option username 'root'
	option password '$p$root'
	list read '*'
	list write '*'
	list read 'lrap'
	list read 'lrap-file'
	list write 'lrap'

config file
       	list path '/tmp/dhcp.leases'

# The customer's account. The password is the admin Linux account's, so the
# same one signs in to SSH, where admin is an ordinary user. In rpcd it may only
# sign in; the portal acts with its own session (backend/sessions.go).
config login
	option username 'admin'
	option password '$p$admin'
	list read 'lrap-login'
	list write 'lrap-login'
